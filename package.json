    "test:mobile": "cross-env ENV=PROD playwright test --project=iphone-12 pixel-7",
    "test:mobile:stg": "cross-env ENV=STG playwright test --project=iphone-12 pixel-7",
    "test:links": "cross-env ENV=PROD playwright test --grep=@links",
    "test:links:stg": "cross-env ENV=STG playwright test --grep=@links",
    "test:links:header": "cross-env ENV=PROD playwright test --grep=@header",
    "test:links:footer": "cross-env ENV=PROD playwright test --grep=@footer"
